        <Filename Value="Utils.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="UnOptions.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="unRecords.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="unframeask.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="FrameAsk"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Frame"/>
        <UnitName Value="unFrameAsk"/>
      </Unit>
      <Unit>
        <Filename Value="unframevideo.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="FrameVideo"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Frame"/>
        <UnitName Value="unFrameVideo"/>
