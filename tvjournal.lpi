        <ResourceBaseClass Value="Frame"/>
        <UnitName Value="unFrameRectAsk"/>
      </Unit>
      <Unit>
        <Filename Value="unask.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="unAsk"/>
      </Unit>
      <Unit>
        <Filename Value="utilitiesdb.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="UtilitiesDB"/>
      </Unit>
      <Unit>
        <Filename Value="unframetopic.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="FrameTopic"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Frame"/>
        <UnitName Value="UnFrameTopic"/>
      </Unit>
      <Unit>
        <Filename Value="unformsubsasks.pas"/>
        <IsPartOfProject Value="True"/>
